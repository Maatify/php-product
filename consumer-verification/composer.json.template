{
    "name": "consumer-verification/maatify-php-product",
    "description": "External consumer fixture for maatify/php-product.",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "__PACKAGE_ROOT__",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "maatify/php-product": "*",
        "maatify/shared-common": "^1.0"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
